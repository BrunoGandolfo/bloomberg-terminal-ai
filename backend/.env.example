# ============================================
# BLOOMBERG TERMINAL AI - CONFIGURACIÓN DEL BACKEND
# ============================================
# Copia este archivo a .env y completa con tus valores
# NO subas el archivo .env a control de versiones

# ============================================
# CONFIGURACIÓN DEL SERVIDOR
# ============================================

# Puerto del servidor Express (por defecto: 5000)
PORT=5000

# Entorno de ejecución: development | production | test
NODE_ENV=development

# Nivel de logs: error | warn | info | debug
LOG_LEVEL=info

# ============================================
# APIs OBLIGATORIAS - El sistema no funciona sin estas
# ============================================

# EODHD API - Datos de mercado, cotizaciones, fundamentales
# Obtener en: https://eodhd.com/register
# Plan gratuito: 20 llamadas/día | Plan pagado: 100,000+ llamadas/día
# Límite actual configurado: 1000 llamadas/minuto
EODHD_API_KEY=your_eodhd_api_key_here

# ============================================
# APIs OPCIONALES - Funcionalidades adicionales
# ============================================

# Anthropic Claude - Análisis con IA avanzada
# Obtener en: https://console.anthropic.com/
# Modelo: Claude 3 Opus/Sonnet
# Sin esta key: El análisis con IA no funcionará
ANTHROPIC_API_KEY=sk-ant-api03-your_key_here

# Perplexity AI - Búsqueda y análisis de noticias financieras
# Obtener en: https://www.perplexity.ai/api
# Modelo: sonar-pro
# Sin esta key: No habrá análisis de noticias en tiempo real
PERPLEXITY_API_KEY=pplx-your_key_here

# Federal Reserve Economic Data (FRED) - Datos macroeconómicos
# Obtener en: https://fred.stlouisfed.org/docs/api/api_key.html
# Gratuito: 120 llamadas/minuto, 500 llamadas/día
# Sin esta key: No habrá datos de VIX, yields, DXY, etc.
FRED_API_KEY=your_fred_api_key_here

# ============================================
# APIs TEMPORALMENTE DESHABILITADAS
# ============================================
# Estas APIs están en el código pero actualmente no funcionan
# según el informe del sistema

# OpenAI GPT-4 - Análisis con IA
# Estado: API key inválida - TEMPORALMENTE DESHABILITADO
# Obtener en: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your_openai_key_here

# Google Gemini - Análisis con IA
# Estado: Servidor sobrecargado - TEMPORALMENTE DESHABILITADO
# Obtener en: https://makersuite.google.com/app/apikey
# GOOGLE_AI_KEY=your_google_ai_key_here

# ============================================
# FUNCIONALIDADES OPCIONALES
# ============================================

# Habilitar análisis técnico (indicadores RSI, MACD, etc.)
# Valores: true | false (por defecto: true)
TECHNICAL_ANALYSIS_ENABLED=true

# ============================================
# NOTAS IMPORTANTES
# ============================================
# 1. Sin EODHD_API_KEY el sistema no puede obtener cotizaciones
# 2. Sin las APIs de IA, los comandos de análisis devuelven error
# 3. El sistema tiene cache para optimizar el uso de APIs:
#    - Cotizaciones: 2 minutos
#    - Fundamentales: 1 hora
#    - Screeners: 5 minutos
#    - Datos macro: 5 minutos
# 4. Los límites de rate están configurados automáticamente
# 5. Para desarrollo local, las APIs opcionales pueden omitirse

# ============================================
# EJEMPLO DE CONFIGURACIÓN MÍNIMA
# ============================================
# PORT=5000
# NODE_ENV=development
# EODHD_API_KEY=tu_clave_aqui
# (El resto son opcionales pero mejoran la funcionalidad)
