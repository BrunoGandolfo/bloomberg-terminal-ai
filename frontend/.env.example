# ============================================
# BLOOMBERG TERMINAL AI - CONFIGURACIÓN DEL FRONTEND
# ============================================
# Copia este archivo a .env y completa con tus valores
# NO subas el archivo .env a control de versiones

# URL de la API del backend
# Para desarrollo local: http://localhost:5000
# Para producción: https://tu-dominio.com
REACT_APP_API_URL=http://localhost:5000

# ============================================
# NOTAS IMPORTANTES
# ============================================
# 1. Las variables de React DEBEN empezar con REACT_APP_
# 2. Reinicia el servidor de desarrollo después de cambiar valores
# 3. Para producción, asegúrate de usar HTTPS
# 4. Esta es la única variable necesaria para el frontend
